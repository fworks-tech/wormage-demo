{
  "name": "wormage-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:engine": "esbuild ../src/game/engine.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lambda/engine.cjs",
    "build:validation": "esbuild ../src/api/validation.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lambda/validation.cjs",
    "build": "npm run build:engine && npm run build:validation && tsc",
    "synth": "npm run build && cdk synth",
    "deploy": "npm run build && cdk deploy",
    "diff": "npm run build && cdk diff",
    "test": "npm run build && node --test lambda/index.test.js test/wormage-stack.test.js test/observability.test.js test/iam.test.js scripts/backfill-ttl.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1175.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
